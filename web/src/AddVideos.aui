Page AddVideos variant=settings
  Text variant=eyebrow "GROW YOUR COLLECTION"
  Heading level=1 "Add videos"
  Text variant=muted "Upload from this device, or connect videos already on your Workspace PC."
  If condition=$admin
    Grid variant=settings
      Card variant=settings-panel
        Heading level=2 "Upload videos"
        Text variant=muted "Your Cinema folders in My Drive are ready to use. Choose Movies, TV Shows or Home Videos, then select videos from your computer or phone."
        If condition=$hasLibraries
          Select name=uploadLibrary label="Save videos to" options=$uploadLibraries disabled=$uploading
          Text variant=path "$uploadDestination"
          Input name=videoFiles type=file placeholder="Choose videos" accept=".mp4,.mkv,.webm,.mov,.avi,.m4v,.ts" multiple=true disabled=$uploading
          Text variant=muted "Each video is saved in its own title folder. Existing files are never replaced. Up to 100 GB per video."
          If condition=$selectedFiles
            Text "$selectedFiles"
          If condition=$uploading
            Metric value=$uploadPercent label="Video upload progress"
            Text "$uploadMessage"
            Button variant=outline action=cancelUploads "Cancel upload"
          If condition=$canUpload
            Button variant=primary icon=Plus action=uploadVideos "Upload selected videos"
        If condition=$noLibraries
          Text "Your media folders are unavailable. Reconnect My Drive or choose another folder below."
        If condition=$uploadResult
          Text variant=upload-result "$uploadResult"
          Button variant=outline action=new "View recently added"
      Card variant=settings-panel
        Heading level=2 "Media folders in My Drive"
        Text variant=muted "Already have videos on the Workspace PC or in My Drive? Connect their folder to index them without copying. For TV shows, keep the Series / Season / Episode folder structure."
        For each=$libraries
          Row variant=library
            Stack
              Text "$item.name"
              Text variant=muted "$item.kind"
              Text variant=path "$item.location"
            Button variant=outline item=$item.id action=changeFolder "Change folder"
        Heading level=3 "Connect another folder"
        Input name=libraryName placeholder="Library name"
        Select name=libraryKind label="Library type" options=$libraryKinds
        Button variant=outline action=chooseFolder icon=FolderPlus "Browse My Drive"
        Text variant=path "$chosenFolder"
        Checkbox name=lookupMetadata label="Look up titles and artwork online using media filenames"
        Button variant=primary action=addLibrary icon=FolderPlus "Connect folder"
        Button variant=outline action=scan icon=RefreshCw "Scan for new videos"
    Text variant=muted "Keep this page open while uploading. Once saved, videos appear after the media scan. Uploaded originals need their own file backup."
  If condition=$notAdmin
    Card variant=empty
      Heading level=2 "Ask your Workspace owner"
      Text "Adding videos requires the Workspace owner and an adult viewing profile."
      Button variant=primary action=profiles "Choose a viewing profile"
